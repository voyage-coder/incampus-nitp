# =============================================================================
# Backend environment variables (copy to .env — never commit .env)
# =============================================================================

# PostgreSQL connection string
# Local:  postgresql://postgres:YOUR_PASSWORD@localhost:5432/incampus_db
# Deploy: use your host's URL (Railway, Render, Supabase, etc.)
DATABASE_URL=postgresql://postgres:password@localhost:5432/incampus_db

# JWT signing secret — REQUIRED in production
# Generate a random string (at least 32 characters). Examples:
#   Python: python -c "import secrets; print(secrets.token_urlsafe(48))"
#   OpenSSL: openssl rand -hex 32
# Use a NEW unique value per environment (dev vs production). Never share or commit it.
SECRET_KEY=change-me-to-a-long-random-secret

# Comma-separated URLs of your frontend — no trailing slashes
# Local dev:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production (set on Render):
# CORS_ORIGINS=https://incampus-nitp.vercel.app

# Google Sign-In (OAuth 2.0 / OpenID Connect)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorized JavaScript origins: http://localhost:5173, https://incampus-nitp.vercel.app
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Only allow campus emails (leave empty to allow any domain in dev)
GOOGLE_ALLOWED_EMAIL_DOMAIN=nitp.ac.in
# Optional: auto-allows all Vercel deploy URLs (*.vercel.app) if unset
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# -----------------------------------------------------------------------------
# PDF export on Render (Python runtime — recommended)
# -----------------------------------------------------------------------------
# In Render → Settings → Build & Deploy, with Root Directory = backend:
#   Build Command:  bash render-build.sh
#   Start Command:  bash start.sh
#
# Or use Docker (Root Directory = backend, Runtime = Docker, Dockerfile = Dockerfile).
