# =============================================================================
# Frontend environment variables (copy to .env — never commit .env)
# =============================================================================

# API base URL
# Local dev: leave empty — Vite proxy forwards /auth, /users, /marketplace, etc.
VITE_API_URL=

# Production: your deployed backend URL (no trailing slash)
# Example: https://api.yourdomain.com
# VITE_API_URL=https://api.yourdomain.com
